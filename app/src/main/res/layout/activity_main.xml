<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:id="@+id/browserRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/toolbar_bg"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/ToolButton"
                android:contentDescription="后退"
                android:src="@drawable/ic_back" />

            <ImageButton
                android:id="@+id/btnForward"
                style="@style/ToolButton"
                android:contentDescription="前进"
                android:src="@drawable/ic_forward" />

            <EditText
                android:id="@+id/urlBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_urlbar"
                android:hint="@string/url_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp"
                android:textColor="#222222"
                android:textColorHint="#9A9A9A"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnReload"
                style="@style/ToolButton"
                android:contentDescription="刷新"
                android:src="@drawable/ic_refresh" />

            <ImageButton
                android:id="@+id/btnMenu"
                style="@style/ToolButton"
                android:contentDescription="菜单"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/theme_red"
            android:visibility="gone" />

        <TextView
            android:id="@+id/trialBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF4D6"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="#8A6A1F"
            android:textSize="12sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/licenseGate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cream"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/license_title"
            android:textColor="@color/theme_red"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gateMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/license_expired"
            android:textColor="#555555"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="@string/license_device_label"
            android:textColor="#888888"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/deviceCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:textColor="#222222"
            android:textIsSelectable="true"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCopyDevice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/license_copy_device" />

        <EditText
            android:id="@+id/licenseInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_urlbar"
            android:gravity="center"
            android:hint="@string/license_input_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:textColor="#222222"
            android:textColorHint="#9A9A9A"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnActivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/theme_red"
            android:text="@string/license_activate"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/gateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#B3261E"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnCheckAgain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="8dp"
            android:text="@string/license_check_again"
            android:textColor="#1A73E8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnLater"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:text="@string/license_later"
            android:textColor="#888888"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/license_hint_footer"
            android:textColor="#999999"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
